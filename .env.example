# URL pública final do MarkTech, somente a origem, sem caminho e sem barra no final.
# Usada no canonical, Open Graph, sitemap, robots.txt e JSON-LD.
# Troque o placeholder antes de publicar em produção.
# Exemplo: https://www.seudominio.com.br
# Com VERCEL_ENV=production, vazio ou marktech.example faz o build falhar.
PUBLIC_SITE_URL=https://marktech.example

# Espaços de anúncio. Só "true" publica o AdSlot. O padrão é desligado.
PUBLIC_ADS_ENABLED=false
