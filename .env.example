# URL pública do site, somente a origem, sem caminho e sem barra no final.
# Usada no canonical, Open Graph, sitemap, robots.txt e JSON-LD.
#
# O valor abaixo é o placeholder do código. Build de produção recusa este host.
# Na Vercel, no ambiente Production, configure:
# PUBLIC_SITE_URL=https://marktech.vercel.app
PUBLIC_SITE_URL=https://marktech.example

# Espaços de anúncio. Só "true" publica o AdSlot. O padrão é desligado.
PUBLIC_ADS_ENABLED=false
